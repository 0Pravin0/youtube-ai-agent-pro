{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YouTube AI Agent Pro",
  "version": "1.0.0",
  "identifier": "com.youtubeaiagentpro.app",
  "build": {
    "frontendDist": "../ui/out-build",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "YouTube AI Agent Pro",
        "width": 1360,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob: http://127.0.0.1:* https://*.ggpht.com https://*.googleusercontent.com https://*.ytimg.com; media-src 'self' blob: http://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "YouTube AI Agent Pro",
    "shortDescription": "Autonomous Tamil YouTube studio for Apple Silicon Macs",
    "longDescription": "Plans, writes, illustrates, voices, animates, renders, publishes and analyses original Tamil YouTube videos using free local AI tools on your Mac.",
    "copyright": "Bundles FFmpeg (GPL, see licenses) and Noto Sans Tamil (SIL OFL).",
    "category": "Video",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../build/engine/": "engine/",
      "../build/licenses/": "licenses/",
      "../USER_GUIDE.md": "USER_GUIDE.md"
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist",
      "dmg": {
        "windowSize": {
          "width": 620,
          "height": 380
        },
        "appPosition": {
          "x": 170,
          "y": 190
        },
        "applicationFolderPosition": {
          "x": 450,
          "y": 190
        }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA2Mjk4NzBDQjNCOTcwMzEKUldReGNMbXpESWNwQmxzdWkyVkJBN3A5dlZYSG1GdmRreURmT3dpYkNyT2ZqV1c0UHJnV28xOUgK",
      "endpoints": [
        "https://github.com/0Pravin0/youtube-ai-agent-pro/releases/latest/download/latest.json"
      ]
    }
  }
}